# Web - see apps/web/.gitignore for the rest (node_modules, .next, env files, etc.)

# Python
.venv/
__pycache__/
*.pyc
.pytest_cache/
.ruff_cache/
.mypy_cache/
*.egg-info/

# Env / secrets
.env
.env.local
.env.worker
.env*.local

# Supabase local
supabase/.temp/
supabase/.branches/

# OS / editor
.DS_Store
Thumbs.db
.vscode/

# Local dev server logs (apps/web/.local-web.*.log) - 수백 KB짜리 실행 로그라
# 커밋 대상이 아니다. 무시 규칙이 없어 실제로 커밋될 뻔했다.
*.local-web.out.log
*.local-web.err.log
