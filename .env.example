# apps/web (Railway) - browser-safe only, with one deliberate exception below.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
PORT=3000
FEATURE_CHALLENGE=true
# Server-only (never NEXT_PUBLIC_*) - comma-separated emails allowed to see /market and
# approve companies. See apps/web/src/lib/features.ts:isPlatformAdmin.
ADMIN_EMAILS=
# Server-only, admin-only-actions use only (apps/web/src/lib/supabase/admin.ts). The one
# deliberate exception to "the web app never holds this key" - needed because
# `authenticated` has no UPDATE privilege on companies.approval_status at all, by design.
# Never reference from a "use client" file. See docs/ARCHITECTURE.md.
SUPABASE_SERVICE_ROLE_KEY=
