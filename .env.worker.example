# Local worker only - never deploy this file or its values to Railway.
DATA_MODE=mock

OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3.5:9b

SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

G2B_API_KEY=
# Apply for "조달청_나라장터 공공데이터개방표준서비스" and paste its Encoding key.
G2B_AWARD_API_KEY=
BIZINFO_API_KEY=
KSTARTUP_API_KEY=

# Watch digest delivery (worker/jobs/digest_job.py). Create a bot via @BotFather and
# paste its token here. Without this set, the digest job logs a warning and sends
# nothing - it does not fail the whole worker. Also requires the
# 20260913120000_telegram_watch_digest.sql migration to be applied (adds
# companies.telegram_chat_id + watch_notifications_sent).
TELEGRAM_BOT_TOKEN=

# Public web address the digest links to when it had to cap the item count
# ("그 외 N건" 안내). No trailing slash. Leave empty to send the notice without a link.
WEB_BASE_URL=

# CHALLENGE - official public notice collection + optional local Ollama analysis
FEATURE_CHALLENGE=true
CHALLENGE_COLLECTION_ENABLED=true
CHALLENGE_COLLECTION_CRON=0 */6 * * *
CHALLENGE_REQUEST_TIMEOUT=15
CHALLENGE_MAX_RETRIES=3
CHALLENGE_AI_ANALYSIS_ENABLED=false

# Optional: override the Python interpreter PM2 launches (see ecosystem.config.cjs)
BIZRADAR_PYTHON=
